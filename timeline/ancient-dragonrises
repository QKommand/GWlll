<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Ancient Dragonrises archive of the Guild Wars Living Lore Library."
  />

  <meta name="theme-color" content="#020617" />

  <title>
    Ancient Dragonrises // Guild Wars Living Lore Library
  </title>

  <style>
    :root {
      color-scheme: dark;

      --background: #020617;
      --panel: #0f172a;
      --panel-light: #111c31;
      --border: #3d4658;

      --gold: #f4c76b;
      --gold-bright: #ffe3a3;
      --gold-soft: #d9ab52;

      --white: #ffffff;
      --white-soft: #f1f5f9;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      margin: 0;
      min-width: 320px;

      background:
        radial-gradient(
          circle at top,
          rgba(244, 199, 107, 0.08),
          transparent 34rem
        ),
        var(--background);

      color: var(--white);

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

      line-height: 1.7;
    }

    a {
      color: inherit;
    }

    .container {
      width: min(1000px, calc(100% - 32px));
      margin-inline: auto;
    }

    /* =========================
       HEADER
    ========================= */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 20;

      border-bottom: 1px solid var(--border);

      background: rgba(2, 6, 23, 0.94);
      backdrop-filter: blur(14px);
    }

    .header-inner {
      min-height: 68px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;
    }

    .brand {
      text-decoration: none;
    }

    .brand-label {
      margin: 0;

      color: var(--white);

      font-family: monospace;
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .brand-name {
      margin: 2px 0 0;

      color: var(--gold);

      font-size: 1rem;
      font-weight: 700;
    }

    .return-link {
      color: var(--gold);

      font-family: monospace;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.05em;

      text-decoration: none;

      transition:
        color 180ms ease,
        transform 180ms ease;
    }

    .return-link:hover {
      color: var(--gold-bright);
      transform: translateX(-3px);
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      padding: 78px 0 62px;
      text-align: center;
    }

    .eyebrow {
      margin: 0;

      color: var(--white);

      font-family: monospace;
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .hero h1 {
      max-width: 850px;
      margin: 16px auto 0;

      color: var(--gold);

      font-size: clamp(2.6rem, 8vw, 5rem);
      line-height: 1.03;
      letter-spacing: -0.045em;

      animation: goldPulse 3.8s ease-in-out infinite;
    }

    .hero-date {
      margin: 18px 0 0;

      color: var(--gold-bright);

      font-family: monospace;
      font-size: 0.82rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero-text {
      max-width: 760px;
      margin: 25px auto 0;

      color: var(--white);

      font-size: 1.07rem;
      line-height: 1.9;
    }

    /* =========================
       RECORD INTRO
    ========================= */

    .record-intro {
      max-width: 820px;
      margin: 0 auto 58px;

      padding: 26px;

      border: 1px solid rgba(244, 199, 107, 0.35);
      border-radius: 12px;

      background: rgba(244, 199, 107, 0.045);
    }

    .record-intro-label {
      margin: 0;

      color: var(--gold);

      font-family: monospace;
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .record-intro p:last-child {
      margin: 12px 0 0;

      color: var(--white);
    }

    /* =========================
       CONTENT
    ========================= */

    .history {
      padding-bottom: 80px;
    }

    .history-section {
      max-width: 820px;
      margin: 0 auto;

      padding: 38px 0;

      border-top: 1px solid var(--border);
    }

    .history-number {
      margin: 0;

      color: var(--white);

      font-family: monospace;
      font-size: 0.66rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .history-section h2 {
      margin: 8px 0 0;

      color: var(--gold);

      font-size: clamp(1.6rem, 5vw, 2.35rem);
      line-height: 1.2;
    }

    .history-section p {
      margin: 17px 0 0;

      color: var(--white);
    }

    .history-section strong {
      color: var(--gold-bright);
    }

    /* =========================
       IMPORTANT RECORD
    ========================= */

    .important-record {
      margin-top: 24px;
      padding: 20px;

      border-left: 2px solid var(--gold);

      background: rgba(15, 23, 42, 0.8);
    }

    .important-record .label {
      margin: 0;

      color: var(--gold);

      font-family: monospace;
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .important-record p:last-child {
      margin: 8px 0 0;
    }

    /* =========================
       KEY RECORDS
    ========================= */

    .key-records {
      max-width: 820px;
      margin: 0 auto;

      padding: 38px 0;

      border-top: 1px solid var(--border);
    }

    .key-records h2 {
      margin: 8px 0 0;

      color: var(--gold);

      font-size: clamp(1.6rem, 5vw, 2.35rem);
    }

    .record-grid {
      margin-top: 24px;

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 14px;
    }

    .record-card {
      padding: 20px;

      border: 1px solid var(--border);
      border-radius: 10px;

      background: rgba(15, 23, 42, 0.75);
    }

    .record-card-label {
      margin: 0;

      color: var(--white);

      font-family: monospace;
      font-size: 0.63rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .record-card h3 {
      margin: 8px 0 0;

      color: var(--gold);

      font-size: 1rem;
    }

    .record-card p:last-child {
      margin: 9px 0 0;

      color: var(--white);

      font-size: 0.9rem;
    }

    /* =========================
       NEXT ERA
    ========================= */

    .navigation-section {
      max-width: 820px;
      margin: 0 auto;
      padding: 45px 0 80px;

      border-top: 1px solid var(--border);
    }

    .navigation-label {
      margin: 0;

      color: var(--white);

      font-family: monospace;
      font-size: 0.67rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .navigation-section h2 {
      margin: 8px 0 0;

      color: var(--gold);

      font-size: 1.7rem;
    }

    .navigation-section > p:not(.navigation-label) {
      margin: 13px 0 0;

      color: var(--white);
    }

    .navigation-actions {
      margin-top: 24px;

      display: flex;
      flex-wrap: wrap;

      gap: 12px;
    }

    .button {
      min-height: 46px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      padding: 0 20px;

      border: 1px solid var(--border);
      border-radius: 9px;

      background: var(--panel);
      color: var(--gold);

      font-weight: 650;
      text-decoration: none;

      transition:
        transform 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        background 180ms ease;
    }

    .button:hover {
      transform: translateY(-2px);

      border-color: rgba(244, 199, 107, 0.65);
      color: var(--gold-bright);
    }

    .button-primary {
      border-color: rgba(244, 199, 107, 0.45);

      background: rgba(244, 199, 107, 0.1);
      color: var(--gold-bright);
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 30px 0;

      border-top: 1px solid var(--border);

      color: var(--white);

      text-align: center;
      font-size: 0.75rem;
    }

    .footer-home {
      display: inline-block;

      margin-bottom: 14px;

      color: var(--gold);

      text-decoration: none;
    }

    .footer-home:hover {
      color: var(--gold-bright);
    }

    /* =========================
       ANIMATION
    ========================= */

    @keyframes goldPulse {
      0%,
      100% {
        color: var(--gold);

        text-shadow:
          0 0 0 rgba(244, 199, 107, 0);
      }

      50% {
        color: var(--gold-bright);

        text-shadow:
          0 0 16px rgba(244, 199, 107, 0.28),
          0 0 34px rgba(244, 199, 107, 0.1);
      }
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 700px) {

      .header-inner {
        min-height: 62px;
      }

      .brand-label {
        display: none;
      }

      .brand-name {
        font-size: 0.86rem;
      }

      .return-link {
        font-size: 0.68rem;
      }

      .hero {
        padding: 58px 0 46px;
      }

      .hero-text {
        font-size: 1rem;
      }

      .record-grid {
        grid-template-columns: 1fr;
      }

      .navigation-actions {
        flex-direction: column;
      }

      .button {
        width: 100%;
      }
    }

    @media (max-width: 430px) {

      .container {
        width: min(100% - 22px, 1000px);
      }

      .brand-name {
        font-size: 0.76rem;
      }

      .return-link {
        font-size: 0.63rem;
      }

      .record-intro {
        padding: 20px;
      }

      .history-section {
        padding: 32px 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       HEADER
  ========================== -->

  <header class="site-header">

    <div class="container header-inner">

      <a
        href="../../index.html"
        class="brand"
        aria-label="Return to Guild Wars Living Lore Library"
      >

        <p class="brand-label">
          QKommand Archive
        </p>

        <p class="brand-name">
          GWlll
        </p>

      </a>

      <a
        href="../../index.html"
        class="return-link"
      >
        ← Return to Timeline
      </a>

    </div>

  </header>


  <main>

    <!-- =========================
         HERO
    ========================== -->

    <section class="hero">

      <div class="container">

        <p class="eyebrow">
          Historical Archive // Record 01
        </p>

        <h1>
          Ancient Dragonrises
        </h1>

        <p class="hero-date">
          Before 10,000 BE
        </p>

        <p class="hero-text">
          Tyria's story does not begin with humanity.
          It does not begin with the Six Gods, the kingdoms of
          Ascalon and Orr, or even the civilizations whose ruins
          still survive beneath the earth.
        </p>

        <p class="hero-text">
          Long before recorded history, the Elder Dragons were
          already here.
        </p>

      </div>

    </section>


    <!-- =========================
         ARCHIVE INTRODUCTION
    ========================== -->

    <div class="container">

      <div class="record-intro">

        <p class="record-intro-label">
          Archive Context
        </p>

        <p>
          Much of this age survives only through ancient ruins,
          fragmented records, racial memory, and discoveries made
          thousands of years later. Exact dates and the order of
          many events remain unknown.
        </p>

      </div>

    </div>


    <!-- =========================
         HISTORY
    ========================== -->

    <section class="history">

      <div class="container">


        <!-- 01 -->

        <article class="history-section">

          <p class="history-number">
            Record 01
          </p>

          <h2>
            Before Recorded History
          </h2>

          <p>
            The oldest history of Tyria reaches into an age where
            even surviving civilizations struggle to separate fact
            from legend.
          </p>

          <p>
            The <strong>Elder Dragons</strong> existed before the
            ancient Giganticus Lupicus. By approximately
            <strong>20,000 BE</strong>, the earliest known
            Dragonrise recorded by later civilizations had already
            occurred.
          </p>

          <p>
            These creatures were not simply powerful animals.
            Their cycles were tied to the magical balance of the
            world itself.
          </p>

        </article>


        <!-- 02 -->

        <article class="history-section">

          <p class="history-number">
            Record 02
          </p>

          <h2>
            The Great Giants
          </h2>

          <p>
            Among the creatures that inhabited ancient Tyria were
            the <strong>Giganticus Lupicus</strong>, remembered in
            later histories as the Great Giants.
          </p>

          <p>
            Their civilization and origins remain largely lost.
            By approximately <strong>10,000 BE</strong>, the last
            known Great Giants disappeared from the Tyrian
            continent.
          </p>

          <p>
            Their disappearance roughly coincides with the suspected
            beginning of the last great rising of the Elder Dragons.
          </p>

        </article>


        <!-- 03 -->

        <article class="history-section">

          <p class="history-number">
            Record 03
          </p>

          <h2>
            The Last Ancient Dragonrise
          </h2>

          <p>
            As the Elder Dragons rose, they consumed enormous
            quantities of magic from the world around them.
          </p>

          <p>
            Civilizations that had flourished for generations were
            suddenly forced to confront creatures capable of
            devastating entire regions in their search for magical
            energy.
          </p>

          <p>
            Five peoples remembered today as the
            <strong>elder races</strong> stood among the most
            magically advanced civilizations of this age:
            the dwarves, Forgotten, jotun, mursaat, and Seers.
          </p>

        </article>


        <!-- 04 -->

        <article class="history-section">

          <p class="history-number">
            Record 04
          </p>

          <h2>
            An Alliance Against the Dragons
          </h2>

          <p>
            Faced with extinction, the elder races attempted to
            cooperate against the Elder Dragons.
          </p>

          <p>
            At some point during this struggle, the
            <strong>mursaat and Forgotten attempted to kill
            Zhaitan</strong>. The effort failed and left both
            peoples devastated.
          </p>

          <p>
            The failure deepened tensions between the ancient
            civilizations and helped fracture the alliance that had
            formed against their common enemy.
          </p>

        </article>


        <!-- 05 -->

        <article class="history-section">

          <p class="history-number">
            Record 05
          </p>

          <h2>
            The Seers' Answer
          </h2>

          <p>
            Defeating the Elder Dragons directly had failed.
            The Seers pursued another solution.
          </p>

          <p>
            They created the first
            <strong>Shadowstone</strong> and later the
            <strong>Bloodstone</strong>, allowing magical energy
            to be hidden away rather than consumed by the dragons.
          </p>

          <div class="important-record">

            <p class="label">
              Historical Significance
            </p>

            <p>
              The Bloodstone would survive long after this ancient
              age and eventually become one of the most important
              magical artifacts in recorded Tyrian history.
            </p>

          </div>

        </article>


        <!-- 06 -->

        <article class="history-section">

          <p class="history-number">
            Record 06
          </p>

          <h2>
            The Mursaat Disappear
          </h2>

          <p>
            The mursaat refused to surrender their magic as the
            other races attempted to hide theirs from the dragons.
          </p>

          <p>
            Their relationship with the Seers collapsed into a
            centuries-long conflict.
          </p>

          <p>
            Eventually the mursaat withdrew from Tyria by
            <strong>phasing into the Mists</strong>.
          </p>

          <p>
            The war between the Seers and mursaat continued across
            generations and ultimately brought the Seers close to
            extinction.
          </p>

        </article>


        <!-- 07 -->

        <article class="history-section">

          <p class="history-number">
            Record 07
          </p>

          <h2>
            Survival
          </h2>

          <p>
            Not every civilization attempted to fight.
          </p>

          <p>
            The <strong>kodan</strong> sought refuge in the distant
            north while other peoples scattered, hid, or abandoned
            territories that could no longer be defended.
          </p>

          <p>
            One kodan tribe eventually traveled south, migrating
            through Janthir and into Orr.
          </p>

          <p>
            Across Tyria, survival increasingly meant avoiding the
            Elder Dragons rather than defeating them.
          </p>

        </article>


        <!-- 08 -->

        <article class="history-section">

          <p class="history-number">
            Record 08
          </p>

          <h2>
            Glint
          </h2>

          <p>
            In <strong>1680 BE</strong>, the Forgotten performed a
            ritual upon <strong>Glint</strong>, a champion and
            scion of the Elder Dragon Kralkatorrik.
          </p>

          <p>
            The ritual freed Glint from Kralkatorrik's control,
            although much of her previous memory was lost.
          </p>

          <p>
            Glint then helped conceal the surviving races from the
            Elder Dragons.
          </p>

          <p>
            Deprived of sufficient magical energy, the dragons
            gradually returned to slumber.
          </p>

        </article>


        <!-- 09 -->

        <article class="history-section">

          <p class="history-number">
            Record 09
          </p>

          <h2>
            The World That Remained
          </h2>

          <p>
            Tyria survived the Dragonrise, but it was not the same
            world that had existed before it.
          </p>

          <p>
            Some ancient civilizations had vanished entirely.
            Others were reduced to scattered survivors.
            The jotun lost much of the knowledge and power of their
            ancestors, while the Seers were pushed toward
            extinction.
          </p>

          <p>
            The dragons slept again.
          </p>

          <p>
            But their cycle had not ended.
          </p>

        </article>


        <!-- =====================
             KEY RECORDS
        ====================== -->

        <section class="key-records">

          <p class="history-number">
            Archive Index
          </p>

          <h2>
            Key Records From This Era
          </h2>

          <div class="record-grid">

            <div class="record-card">

              <p class="record-card-label">
                People
              </p>

              <h3>
                The Elder Races
              </h3>

              <p>
                Dwarves, Forgotten, jotun, mursaat, and Seers.
              </p>

            </div>


            <div class="record-card">

              <p class="record-card-label">
                Magic
              </p>

              <h3>
                The Bloodstone
              </h3>

              <p>
                The Seers' answer to the Elder Dragons'
                consumption of magic.
              </p>

            </div>


            <div class="record-card">

              <p class="record-card-label">
                The Mists
              </p>

              <h3>
                Mursaat Withdrawal
              </h3>

              <p>
                The mursaat abandon the alliance and disappear
                into the Mists.
              </p>

            </div>


            <div class="record-card">

              <p class="record-card-label">
                Dragon History
              </p>

              <h3>
                Glint's Liberation
              </h3>

              <p>
                The Forgotten free Glint from Kralkatorrik's
                control.
              </p>

            </div>

          </div>

        </section>


        <!-- =====================
             NAVIGATION
        ====================== -->

        <section class="navigation-section">

          <p class="navigation-label">
            Continue the Road Through Time
          </p>

          <h2>
            The Elder Races
          </h2>

          <p>
            The Elder Dragons eventually returned to their slumber,
            but the civilizations that survived them carried the
            scars of the Dragonrise into the ages that followed.
          </p>

          <div class="navigation-actions">

            <a
              href="../../index.html#timeline"
              class="button"
            >
              ← Main Timeline
            </a>

            <a
              href="../elder-races/index.html"
              class="button button-primary"
            >
              Continue to the Elder Races →
            </a>

          </div>

        </section>

      </div>

    </section>

  </main>


